# Variables publiques (injectées dans le bundle — ne jamais y mettre un secret).
# Copier ce fichier en .env.local et renseigner les valeurs.

# URL du Web App Google Apps Script (voir docs/data-google-sheet.md)
VITE_API_URL=

# Clé publique Cloudflare Turnstile (voir docs/security.md)
VITE_TURNSTILE_SITE_KEY=

# Chemin de déploiement (optionnel ; défaut : /ludotheque/)
# VITE_BASE_PATH=/
